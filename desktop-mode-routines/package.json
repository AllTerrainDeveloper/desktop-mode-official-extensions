{
	"name": "desktop-mode-routines",
	"version": "0.22.0",
	"description": "Visual automation engine for Desktop Mode.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run vendor:pixi && npm run build:dev && npm run build:prod",
		"build:dev": "vite build --mode development",
		"build:prod": "vite build --mode production",
		"dev": "vite build --mode development --watch",
		"vendor:pixi": "node -e \"require('fs').mkdirSync('assets/vendor', { recursive: true }); require('fs').cpSync('node_modules/pixi.js/dist/pixi.min.js', 'assets/vendor/pixi.min.js')\""
	},
	"devDependencies": {
		"typescript": "5.9.3",
		"vite": "^5.4.10"
	},
	"dependencies": {
		"pixi.js": "^8.18.1"
	}
}
